{
  "name": "metagaming-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "MetaGaming monorepo workspace for client and server",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:server && npm run build:client",
    "db:init": "npm --workspace=server run db:init",
    "test:server": "npm --workspace=server run test",
    "test:client": "npm --workspace=client run test",
    "test": "npm run test:server && npm run test:client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.13.1"
  }
}
