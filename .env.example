# ==============================================================================
# MetaGaming Environment Variables Template
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=supersecret_dev_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
# Local Docker / Dev:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metagaming
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metagaming

# Vercel Postgres / Prisma Postgres (Cloud):
# POSTGRES_URL=postgres://default:xxx@ep-xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require
# POSTGRES_PRISMA_URL=postgres://default:xxx@ep-xxx-pooler.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true
# DATABASE_SSL=true

# Client Configuration
# Optional: backend API base URL (defaults to same-origin "" in production/Vercel or Vite dev proxy)
VITE_API_URL=http://localhost:3000
