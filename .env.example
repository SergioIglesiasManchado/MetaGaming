# ==============================================================================
# MetaGaming Environment Variables Template
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=supersecret_dev_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metagaming
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metagaming

# Client Configuration
VITE_API_URL=http://localhost:3000
